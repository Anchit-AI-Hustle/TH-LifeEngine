# Google Gemini AI API Key
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Vercel Blob Storage (for file uploads)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_YOUR_TOKEN_HERE

# Vercel API Key (for deployments)
VERCEL_API_KEY=vck_YOUR_VERCEL_API_KEY_HERE

# Optional: Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# Sign-in: scrypt "salt:hash" of the owner's 4-digit PIN.
# Make it with: printf 4827 | node scripts/pin-hash.mjs
# Without it, sign-in stays closed.
APP_PIN_HASH=

# Optional: share the 5-try PIN lockout across server instances (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
