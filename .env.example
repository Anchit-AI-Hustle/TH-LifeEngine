# Google Gemini AI API Key
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Vercel Blob Storage (for file uploads)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_YOUR_TOKEN_HERE

# Vercel API Key (for deployments)
VERCEL_API_KEY=vck_YOUR_VERCEL_API_KEY_HERE

# Optional: Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# Accounts (mobile number + 4-digit PIN). At least 32 random characters; without
# it, sign-in stays closed. Rotating it signs everyone out and invalidates PINs.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Optional: this mobile number's account receives the data saved before accounts existed.
LEGACY_OWNER_MOBILE=

# Optional: share the 5-try PIN lockout across server instances (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
